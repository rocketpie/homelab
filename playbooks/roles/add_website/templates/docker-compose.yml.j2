services:
{% if 'website' in add_website_services %}
  website:
    image: "{{ add_website_image_prefix }}/website:latest"
    pull_policy: never
    restart: unless-stopped
    expose:
      - "80"
    labels:
      com.co3d.service: public
    networks:
      - proxy
{% endif %}
{% if 'lobby' in add_website_services %}
  lobby:
    image: "{{ add_website_image_prefix }}/lobby:latest"
    pull_policy: never
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    mem_limit: 128m
    pids_limit: 64
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    expose:
      - "8080"
    labels:
      com.co3d.service: public
    networks:
      - proxy
{% endif %}

networks:
  proxy:
    external: true
    name: {{ add_website_proxy_network_name }}
